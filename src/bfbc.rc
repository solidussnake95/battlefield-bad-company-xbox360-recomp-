1 ICON "bfbc.ico"

// The recompiled exe ships without any version metadata, which is itself one of
// the things heuristic scanners weigh ("unsigned, unversioned, 60 MB"). Keep
// this block in sync with the release notes.
1 VERSIONINFO
FILEVERSION     2,1,0,0
PRODUCTVERSION  2,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "BFBC Recomp"
            VALUE "FileDescription",  "Battlefield: Bad Company - native x64 recompilation"
            VALUE "FileVersion",      "2.1.0.0"
            VALUE "InternalName",     "bfbc"
            VALUE "LegalCopyright",   "Fan recompilation; game content (c) EA/DICE"
            VALUE "OriginalFilename", "bfbc.exe"
            VALUE "ProductName",      "BFBC Recomp"
            VALUE "ProductVersion",   "2.1"
            VALUE "Comments",         "Built from the user's own copy of the game"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// asInvoker only: the game must not prompt for elevation. The Windows 10/11
// compatibility GUID is what every current toolchain sets by default.
1 RT_MANIFEST "bfbc.manifest"
